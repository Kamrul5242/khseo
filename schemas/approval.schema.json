{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kamrul5242/khseo/schemas/approval.schema.json",
  "title": "KHSEO Approval",
  "description": "One approval request for R2-R4 work. Approval covers exactly this action, scope and project state.",
  "type": "object",
  "required": ["id", "action", "scope", "priority", "risk", "status", "recovery", "project_state"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^APR-[A-Za-z0-9-]+$"},
    "action": {"type": "string", "minLength": 3},
    "reason": {"type": "string"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "files": {"type": "array", "items": {"type": "string"}},
        "pages": {"type": "array", "items": {"type": "string"}},
        "systems": {"type": "array", "items": {"type": "string"}}
      }
    },
    "items": {
      "type": "array",
      "description": "Batch members; 'approve changes 1 and 2' approves by number.",
      "items": {
        "type": "object",
        "required": ["n", "action", "risk"],
        "properties": {
          "n": {"type": "integer", "minimum": 1},
          "action": {"type": "string"},
          "risk": {"$ref": "#/$defs/risk"},
          "approved": {"type": "boolean"}
        }
      }
    },
    "priority": {"enum": ["P0", "P1", "P2", "P3"]},
    "risk": {"$ref": "#/$defs/risk"},
    "status": {"enum": ["PENDING", "APPROVED", "PARTIALLY_APPROVED", "REJECTED", "EXPIRED", "STALE", "REVOKED", "EXECUTED"]},
    "requested_at": {"type": "string"},
    "decided_at": {"type": "string"},
    "expires": {"enum": ["END_OF_SESSION", "PROJECT_STATE_CHANGE", "THIS_OPERATION", "THIS_ATTEMPT"]},
    "recovery": {
      "type": "object",
      "required": ["level", "backup_status"],
      "additionalProperties": false,
      "properties": {
        "level": {"enum": ["FULL", "PARTIAL", "LIMITED", "NONE"]},
        "backup_status": {"enum": ["VERIFIED", "CREATED_UNVERIFIED", "NOT_NEEDED", "NOT_AVAILABLE"]},
        "backup_id": {"type": "string"},
        "rollback_method": {"type": "string"}
      }
    },
    "project_state": {
      "type": "object",
      "description": "Fingerprint taken at request time; if it differs at execution, status becomes STALE.",
      "properties": {
        "git_head": {"type": "string"},
        "branch": {"type": "string"},
        "files_fingerprint": {"type": "string"}
      }
    }
  },
  "$defs": {
    "risk": {"enum": ["R2", "R3", "R4"]}
  }
}
