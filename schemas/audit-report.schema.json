{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kamrul5242/khseo/schemas/audit-report.schema.json",
  "x-khseo-schema-version": "1.1",
  "title": "KHSEO Audit Report",
  "type": "object",
  "required": [
    "target",
    "scope",
    "overall_status",
    "summary",
    "findings",
    "not_tested"
  ],
  "properties": {
    "target": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "object",
      "required": [
        "depth",
        "urls_inspected"
      ],
      "properties": {
        "depth": {
          "enum": [
            "quick",
            "standard",
            "deep",
            "full"
          ]
        },
        "urls_inspected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "overall_status": {
      "enum": [
        "critical",
        "needs_work",
        "healthy"
      ]
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "action_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step",
          "action",
          "priority"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "action": {
            "type": "string"
          },
          "priority": {
            "$ref": "#/$defs/priority"
          },
          "risk": {
            "$ref": "#/$defs/risk"
          },
          "owner": {
            "enum": [
              "khseo",
              "user",
              "developer",
              "platform",
              "unknown"
            ]
          }
        }
      }
    },
    "ai_search_readiness": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "area",
          "status"
        ],
        "properties": {
          "area": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "not_tested": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "site_name": {
      "type": "string"
    },
    "prepared_by": {
      "type": "string",
      "description": "e.g. 'KHSEO v1.2 via Claude Code'"
    },
    "capabilities": {
      "type": "object",
      "description": "host capabilities used for this audit (see capabilities.schema.json)",
      "additionalProperties": {
        "enum": [
          "AVAILABLE",
          "UNAVAILABLE",
          "READ_ONLY"
        ]
      }
    },
    "what_khseo_can_do": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertain": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rankings": {
      "type": "array",
      "description": "Ranking results actually observed. position null = not found in the results checked.",
      "items": {
        "type": "object",
        "required": [
          "keyword",
          "position",
          "source",
          "date"
        ],
        "additionalProperties": false,
        "properties": {
          "keyword": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "checked_depth": {
            "type": "integer",
            "minimum": 1,
            "description": "how many results were checked, e.g. 20"
          },
          "url": {
            "type": "string"
          },
          "engine": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "device": {
            "enum": [
              "desktop",
              "mobile",
              "any"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 3,
            "description": "e.g. 'Search Console', 'live SERP via browser'"
          },
          "date": {
            "type": "string",
            "minLength": 8
          },
          "label": {
            "enum": [
              "VERIFIED",
              "OBSERVED"
            ]
          },
          "target": {
            "type": "string",
            "description": "goal, e.g. 'top 3' (a target, not a guarantee)"
          }
        }
      }
    },
    "versions": {
      "type": "object",
      "description": "versions that produced this audit (scripts/khseo_version.py)",
      "additionalProperties": false,
      "properties": {
        "khseo": {
          "type": "string"
        },
        "spec": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "probe": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "risk": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "label": {
      "enum": [
        "VERIFIED",
        "OBSERVED",
        "INFERRED",
        "RECOMMENDED",
        "ASSUMED",
        "UNKNOWN",
        "NOT TESTED"
      ]
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "layer",
        "priority",
        "label",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "layer": {
          "enum": [
            "crawlability",
            "indexability",
            "technical",
            "on_page",
            "entity",
            "semantic",
            "aeo",
            "geo",
            "llm",
            "eeat",
            "information_gain",
            "structured_data",
            "internal_links",
            "reputation",
            "ai_readiness"
          ]
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "message": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "fix": {
          "type": "string"
        },
        "fix_risk": {
          "$ref": "#/$defs/risk"
        },
        "section": {
          "type": "string",
          "description": "optional display group"
        },
        "owner": {
          "enum": [
            "khseo",
            "user",
            "developer",
            "platform",
            "unknown"
          ]
        }
      }
    }
  }
}